<?xml version="1.0" encoding="utf-8"?>
<!-- WiX v3: Flutter Windows Release -> MSI.
     Installer strings are ASCII-only: Windows Installer default code page
     is 1252 and rejects CJK in Product/Shortcut metadata. App UI stays Chinese. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product
    Id="*"
    Name="ZhuanzhuanMiao"
    Language="1033"
    Codepage="1252"
    Version="1.0.0"
    Manufacturer="NeuroMatrix-Lab"
    UpgradeCode="B7E2C4A1-8F3D-4E6A-9C21-5D8F0A7E6B34">
    <Package
      InstallerVersion="500"
      Compressed="yes"
      InstallScope="perMachine"
      Platform="x64"
      Description="ZhuanzhuanMiao - cross-platform audio/video converter"
      Comments="GitHub Actions" />
    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Icon Id="AppIcon" SourceFile="packaging\windows\app_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/NeuroMatrix-Lab/zhuanzhuan_miao" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="ZhuanzhuanMiao" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="ZhuanzhuanMiao" />
      </Directory>
      <Directory Id="DesktopFolder" />
    </Directory>

    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="StartMenuShortcut" Guid="A1B2C4A1-8F3D-4E6A-9C21-5D8F0A7E6B34">
        <Shortcut
          Id="StartMenuShortcutLink"
          Name="ZhuanzhuanMiao"
          Description="Cross-platform audio/video converter"
          Target="[INSTALLFOLDER]flutter_ffmpeg_converter.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon" />
        <RemoveFolder Id="RemoveApplicationProgramsFolder" On="uninstall" />
        <RegistryValue
          Root="HKCU"
          Key="Software\NeuroMatrix-Lab\ZhuanzhuanMiao"
          Name="StartMenuShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="C0FFEE00-1234-5678-9ABC-DEF012345678">
        <Shortcut
          Id="DesktopShortcutLink"
          Name="ZhuanzhuanMiao"
          Description="Cross-platform audio/video converter"
          Target="[INSTALLFOLDER]flutter_ffmpeg_converter.exe"
          WorkingDirectory="INSTALLFOLDER"
          Icon="AppIcon" />
        <RegistryValue
          Root="HKCU"
          Key="Software\NeuroMatrix-Lab\ZhuanzhuanMiao"
          Name="DesktopShortcut"
          Type="integer"
          Value="1"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="ProductFeature" Title="ZhuanzhuanMiao" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>
  </Product>
</Wix>
